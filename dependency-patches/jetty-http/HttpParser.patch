+    private boolean parseChunkSize(ByteBuffer buffer)
+    {
+        while (_state == State.CHUNK_SIZE && buffer.hasRemaining())
+        {
+            HttpTokens.Token t = next(buffer);
+            if (t == null)
+                break;
+
+            switch (_chunkSizeState)
+            {
+                case SIZE:
+                {
+                    if (t.getType() == HttpTokens.Type.LF)
+                    {
+                        if (chunkSizeEnd())
+                            return true;
+                    }
+                    else if (t.isHexDigit())
+                    {
+                        // Retain Jetty 9's existing integer chunk size limit.
+                        if (_chunkLength > MAX_CHUNK_LENGTH)
+                            throw new BadMessageException(HttpStatus.PAYLOAD_TOO_LARGE_413);
+                        _chunkLength = _chunkLength * 16 + t.getHexDigit();
+                    }
+                    else if (isBWS(t))
+                        _chunkSizeState = ChunkSizeState.EXT_BWS;
+                    else if (t.getChar() == ';')
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_BEFORE;
+                    else
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_BWS:
+                {
+                    if (t.getChar() == ';')
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_BEFORE;
+                    else if (!isBWS(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_NAME_BWS_BEFORE:
+                {
+                    if (isTchar(t))
+                        _chunkSizeState = ChunkSizeState.EXT_NAME;
+                    else if (!isBWS(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_NAME:
+                {
+                    if (t.getType() == HttpTokens.Type.LF)
+                    {
+                        if (chunkSizeEnd())
+                            return true;
+                    }
+                    else if (t.getChar() == ';')
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_BEFORE;
+                    else if (isBWS(t))
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_AFTER;
+                    else if (t.getChar() == '=')
+                        _chunkSizeState = ChunkSizeState.EXT_VALUE_BWS_BEFORE;
+                    else if (!isTchar(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_NAME_BWS_AFTER:
+                {
+                    if (t.getChar() == ';')
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_BEFORE;
+                    else if (t.getChar() == '=')
+                        _chunkSizeState = ChunkSizeState.EXT_VALUE_BWS_BEFORE;
+                    else if (!isBWS(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_VALUE_BWS_BEFORE:
+                {
+                    if (t.getChar() == '"')
+                        _chunkSizeState = ChunkSizeState.EXT_VALUE_OPEN_QUOTE;
+                    else if (isTchar(t))
+                        _chunkSizeState = ChunkSizeState.EXT_VALUE;
+                    else if (!isBWS(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_VALUE_OPEN_QUOTE:
+                {
+                    if (_chunkQuotedEscape)
+                    {
+                        if (!isQuotedPair(t))
+                            throw new IllegalCharacterException(_state, t, buffer);
+                        _chunkQuotedEscape = false;
+                    }
+                    else if (t.getChar() == '\\')
+                        _chunkQuotedEscape = true;
+                    else if (t.getChar() == '"')
+                        _chunkSizeState = ChunkSizeState.EXT_VALUE_CLOSE_QUOTE;
+                    else if (!isQdText(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_VALUE:
+                {
+                    if (t.getType() == HttpTokens.Type.LF)
+                    {
+                        if (chunkSizeEnd())
+                            return true;
+                    }
+                    else if (isBWS(t))
+                        _chunkSizeState = ChunkSizeState.EXT_BWS;
+                    else if (t.getChar() == ';')
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_BEFORE;
+                    else if (!isTchar(t))
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                case EXT_VALUE_CLOSE_QUOTE:
+                {
+                    if (t.getType() == HttpTokens.Type.LF)
+                    {
+                        if (chunkSizeEnd())
+                            return true;
+                    }
+                    else if (isBWS(t))
+                        _chunkSizeState = ChunkSizeState.EXT_BWS;
+                    else if (t.getChar() == ';')
+                        _chunkSizeState = ChunkSizeState.EXT_NAME_BWS_BEFORE;
+                    else
+                        throw new IllegalCharacterException(_state, t, buffer);
+                    break;
+                }
+                default:
+                    throw new IllegalStateException(_chunkSizeState.toString());
+            }
+        }
+        return false;
+    }
