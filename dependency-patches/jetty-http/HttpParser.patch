+    private boolean chunkSizeEnd()
+    {
+        _chunkSizeState = ChunkSizeState.SIZE;
+        if (_chunkLength == 0)
+        {
+            setState(State.TRAILER);
+            return _handler.contentComplete();
+        }
+        else
+        {
+            setState(State.CHUNK);
+            return false;
+        }
+    }
